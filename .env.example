# Database
DATABASE_URL=postgres://user:password@localhost:5432/vaudit_hr

# NextAuth
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (vaudit / blokid workspace credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of allowed sign-in domains
ALLOWED_EMAIL_DOMAINS=vaudit.com,blokid.com

# Slack — bot token (xoxb-...) and the Slack user ID that should receive
# birthday DMs. Set to the ID of the single configured HR_ADMIN.
SLACK_BOT_TOKEN=
SLACK_HR_ADMIN_SLACK_USER_ID=

# Cron — bearer secret for /api/cron/birthdays
CRON_SECRET=
